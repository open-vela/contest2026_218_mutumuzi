+#define SCREEN_MQ_NAME        "briefing"
+#define SCREEN_MQ_MAXMSG      4
+#define SCREEN_MQ_MSGSIZE     1024    /* == CONFIG_MQ_MAXMSGSIZE */
+#define SCREEN_MQ_PAYLOAD_MAX 1023    /* UTF-8 safe cap incl. NUL */
+static mqd_t s_screen_mq = (mqd_t)-1;
+static int   s_screen_mq_open_tried;
+
 /* ── Forward declarations ──────────────────────────────────── */
 
