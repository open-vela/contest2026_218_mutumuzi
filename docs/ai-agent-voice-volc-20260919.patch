+/* 线性插值重采样 + 声道扩展。输入取第 0 声道（AI 语音路径是单声道；
+ * 立体声输入也只会用到左声道，够用且无歧义）。 */
+static int pb_convert(audio_playback_t* pb, const void* in, size_t in_len,
+    const void** out, size_t* out_len)
+{
+    const int16_t* src = (const int16_t*)in;
+    size_t in_frames = in_len / (sizeof(int16_t) * pb->in_channels);
+    size_t out_frames;
+    size_t need;
+    size_t f, c;
+
+    if (in_frames == 0) {
+        return -EINVAL;
+    }
+
+    out_frames = (size_t)((uint64_t)in_frames * PB_OUT_RATE / pb->in_rate);
+    need = out_frames * PB_OUT_CHANNELS * sizeof(int16_t);
+
+    if (need > pb->scratch_cap) {
+        int16_t* p = realloc(pb->scratch, need);
+
+        if (!p) {
+            return -ENOMEM;
+        }
+
+        pb->scratch = p;
+        pb->scratch_cap = need;
+    }
+
+    for (f = 0; f < out_frames; f++) {
+        uint64_t pos = (uint64_t)f * pb->in_rate;
+        size_t i0 = (size_t)(pos / PB_OUT_RATE);
+        size_t i1;
+        uint32_t frac = (uint32_t)(pos % PB_OUT_RATE);
+        int32_t s;
+
+        if (i0 >= in_frames) {
+            i0 = in_frames - 1;
+        }
+
+        i1 = (i0 + 1 < in_frames) ? i0 + 1 : i0;
+        s = src[i0 * pb->in_channels];
+
+        if (i1 != i0) {
+            s += (int32_t)(((int32_t)src[i1 * pb->in_channels] - s)
+                * (int64_t)frac / PB_OUT_RATE);
+        }
+
+        for (c = 0; c < PB_OUT_CHANNELS; c++) {
+            pb->scratch[f * PB_OUT_CHANNELS + c] = (int16_t)s;
+        }
+    }
+
+    *out = pb->scratch;
+    *out_len = need;
+    return 0;
+}
