+#ifdef CONFIG_AI_AGENT_BLE_GATT
+/**
+ * Runs in a background thread: initializes the BLE GATT channel.
+ * Fast retries first, then keeps trying every 30s so BLE comes up
+ * whenever the BT service (bluetoothd) becomes ready.
+ */
+static void* ble_gatt_init_task(void* arg)
+{
+    (void)arg;
+    extern void ble_cmd_handler_recv(const uint8_t* data, uint16_t len,
+        void* user_data);
+
+    ble_gatt_config_t ble_cfg = {
+        .device_name = "VelaClaw",
+        .recv_cb = ble_cmd_handler_recv,
+    };
+
+    int rc = -1;
+    int attempts = 0;
+
+    while (rc < 0 && !g_shutdown_requested) {
+        /* Ensure adapter LE is enabled before GATT init */
+        bt_instance_t* bt_ins = bluetooth_get_instance();
+        if (bt_ins) {
+            bt_adapter_state_t state = bt_adapter_get_state(bt_ins);
+            if (state < BT_ADAPTER_STATE_BLE_ON) {
+                syslog(LOG_INFO, "[%s] BT not ready (state=%d), enabling LE...\n",
+                    TAG, (int)state);
+                bt_adapter_enable_le(bt_ins);
+                sleep(2);
+            }
+        }
+
+        rc = ble_gatt_init(&ble_cfg);
+        if (rc == 0) {
+            syslog(LOG_INFO, "[%s] ble_gatt init OK (attempt %d)\n",
+                TAG, attempts + 1);
+            break;
+        }
+
+        /* 5 fast retries (3s), then retry every 30s in the background.
+         * Log only every 10th slow attempt to avoid console spam. */
+        if (attempts < 5 || attempts % 10 == 0) {
+            syslog(LOG_WARNING, "[%s] ble_gatt_init attempt %d failed: %d\n",
+                TAG, attempts + 1, rc);
+        }
+        sleep(attempts < 5 ? 3 : 30);
+        attempts++;
+    }
+
+    return NULL;
+}
+#endif
