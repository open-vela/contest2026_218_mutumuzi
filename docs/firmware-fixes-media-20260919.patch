+/****************************************************************************
+ * AI 简报卡片（主界面右上角常显，显示最新简报摘要）
+ ****************************************************************************/
+static void create_briefing_card(lv_obj_t *parent)
+{
+    /* 卡片几何：右上空白象限（x165..315 × y15..135），不遮挡左半
+     * datetime_area(≤160) 与 y140 起的四窗卡片 */
+    lv_obj_t *card = lv_obj_create(parent);
+    lv_obj_set_size(card, 150, 120);
+    lv_obj_align(card, LV_ALIGN_TOP_RIGHT, -5, 15);
+    lv_obj_set_style_bg_color(card, lv_color_hex(0x2C3E50), 0);
+    lv_obj_set_style_bg_opa(card, LV_OPA_70, 0);
+    lv_obj_set_style_radius(card, 8, 0);
+    lv_obj_set_style_border_width(card, 0, 0);
+
+    /* 标题 */
+    lv_obj_t *title = lv_label_create(card);
+    lv_label_set_text(title, "AI 简报");
+    lv_obj_set_style_text_font(title, g_misans_normal_12, 0);
+    lv_obj_set_style_text_color(title, lv_color_hex(0xFFFFFF), 0);
+    lv_obj_set_pos(title, 8, 6);
+
+    /* 正文：固定高裁剪容器（仿 gamble 弹窗模式），超长只纵向滚动不越界 */
+    lv_obj_t *body = lv_obj_create(card);
+    lv_obj_set_pos(body, 8, 26);
+    lv_obj_set_size(body, 134, 86);
+    lv_obj_set_style_bg_opa(body, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(body, 0, 0);
+    lv_obj_set_style_pad_all(body, 0, 0);
+    lv_obj_set_scroll_dir(body, LV_DIR_VER);
+    lv_obj_set_scrollbar_mode(body, LV_SCROLLBAR_MODE_OFF);
+
+    briefing_body_label = lv_label_create(body);
+    lv_obj_set_style_text_font(briefing_body_label, g_misans_normal_11, 0);
+    lv_obj_set_style_text_color(briefing_body_label, lv_color_hex(0xECF0F1), 0);
+    lv_label_set_long_mode(briefing_body_label, LV_LABEL_LONG_WRAP);
+    lv_obj_set_width(briefing_body_label, 134);
+    lv_label_set_text(briefing_body_label, "暂无简报");
+}
+
+/* 清洗：丢弃 4 字节 emoji（MiSans 无字形）+ UTF-8 安全截断 */
+static void briefing_sanitize(const char *src)
+{
+    size_t o = 0;
+    const unsigned char *p = (const unsigned char *)src;
+
+    while (*p && o + 3 < BRIEFING_BODY_MAX) {
+        if (*p >= 0xF0) {
+            p += 4;   /* emoji/非 BMP：整字符跳过 */
+            continue;
+        }
+        if (*p < 0x80) {          /* ASCII 1 字节 */
+            briefing_display[o++] = (char)*p++;
+        } else if (*p < 0xE0) {   /* 2 字节 */
+            briefing_display[o++] = (char)*p++;
+            if (*p) briefing_display[o++] = (char)*p++;
+        } else {                  /* 3 字节 CJK */
+            briefing_display[o++] = (char)*p++;
+            if (*p) briefing_display[o++] = (char)*p++;
+            if (*p) briefing_display[o++] = (char)*p++;
+        }
+    }
+    briefing_display[o] = '\0';
+}
+
+/* 惰性打开 + O_CREAT：ai_agent 没起也能建队列，谁先起都行 */
+static int briefing_mq_open_once(void)
+{
+    if (briefing_mq >= 0) {
+        return 0;
+    }
+
+    struct mq_attr attr = {
+        .mq_maxmsg = BRIEFING_MQ_MAXMSG,
+        .mq_msgsize = BRIEFING_MQ_MSGSIZE,
+    };
+    briefing_mq = mq_open(BRIEFING_MQ_NAME,
+                          O_RDONLY | O_CREAT | O_NONBLOCK, 0666, &attr);
+    if (briefing_mq == (mqd_t)-1) {
+        LV_LOG_WARN("Briefing mq_open failed: %d", errno);
+        return -1;   /* 下个 tick 重试 */
+    }
+    LV_LOG_INFO("Briefing mqueue open ok");
+    return 0;
+}
+
+/* 1s lv_timer：排空队列，取最后一条刷新 label */
+static void briefing_poll_cb(lv_timer_t *timer)
+{
+    LV_UNUSED(timer);
+    if (briefing_mq_open_once() != 0) {
+        return;
+    }
+
+    bool got = false;
+    int i;
+    for (i = 0; i < BRIEFING_MQ_MAXMSG; i++) {
+        ssize_t n = mq_receive(briefing_mq, briefing_mq_buf,
+                               BRIEFING_MQ_MSGSIZE, NULL);
+        if (n < 0) {
+            break;   /* EAGAIN=空队列；其它错误也退出 */
+        }
+        briefing_mq_buf[n] = '\0';
+        got = true;
+    }
+    if (got) {
+        briefing_sanitize(briefing_mq_buf);
+        lv_label_set_text(briefing_body_label, briefing_display);
+        LV_LOG_INFO("Briefing card updated: %.60s", briefing_display);
+    }
+}
