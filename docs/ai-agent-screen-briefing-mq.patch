+/* ── Screen briefing card mqueue (ai_agent -> luncher_mini) ──
+ * Cross-process POSIX mqueue. Name has NO leading '/' (board config
+ * CONFIG_FS_MQUEUE_NAME_INITIAL_SLASH is off -> /var/mqueue/<name>).
+ * Constants MUST match luncher_mini.c BRIEFING_MQ_*. */
+#define SCREEN_MQ_NAME        "briefing"
+#define SCREEN_MQ_MAXMSG      4
+#define SCREEN_MQ_MSGSIZE     1024    /* == CONFIG_MQ_MAXMSGSIZE */
+#define SCREEN_MQ_PAYLOAD_MAX 1023    /* UTF-8 safe cap incl. NUL */
+static mqd_t s_screen_mq = (mqd_t)-1;
+static int   s_screen_mq_open_tried;
+
 /* ── Forward declarations ──────────────────────────────────── */
 
 static char* handle_slash_note(const agent_msg_t* msg);
